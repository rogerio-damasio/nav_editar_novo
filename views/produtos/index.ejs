<%- include("../partials/header") %>
    <%- include("../partials/nav") %>
        <div class="container mt-5">
            <div class="d-flex justify-content-between
                align-items-center mb-4">
                <div class="card shadow-sm text-bg-dark d-flex justify-content-between
                align-items-center p-2  bg-secondary rounded-4">
                    <h1>Produtos</h1>
                </div>

                <% 
                    let valorTotalEstoque = produtos.reduce((total, prod) => total + (Number(prod.preco) * Number(prod.estoque)), 0);
                %>
                <div class="card border-0 shadow-sm rounded-4 px-4 py-2 bg-white d-flex flex-row align-items-center gap-4">
                    
                    <!-- Indicador de Quantidade -->
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                            <i class="bi bi-box-seam fs-6"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block" style="font-size: 10px;">Total</span>
                            <span class="fw-bold fs-6 text-dark"><%= produtos.length %> produtos</span>
                        </div>
                    </div>

                    <!-- Divisor vertical do Bootstrap -->
                    <div class="vr text-muted opacity-25" style="height: 30px;"></div>

                    <!-- Indicador de Preço Total -->
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                            <i class="bi bi-currency-dollar fs-6"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block" style="font-size: 10px;">Em Estoque</span>
                            <span class="fw-bold fs-6 text-success">R$ <%= valorTotalEstoque.toFixed(2) %></span>
                        </div>
                    </div>
                </div>
                
                <a href="/produtos/cadastro" class="btn btn-primary">
                    + Novo Produto
                </a>
            </div>
            <div class="card shadow-sm text-bg-dark rounded-4">
                <div class="card-body">
                    <div class="table-responsive rounded-3">
                        <table class="table table-hover
                              align-middle ">
                            <thead class="table-light ">
                                <tr>
                                    <th>ID</th>
                                    <th>Nome</th>
                                    <th>Descrição</th>
                                    <th>Preço</th>
                                    <th>Estoque</th>
                                    <th>Categoria</th>
                                    <th>Opções</th>
                                </tr>
                            </thead>
                            <tbody class="table-dark">
                                <% produtos.forEach(mostrar=> { %>
                                    <tr>
                                        <td>
                                            <%= mostrar.id %>
                                        </td>
                                        <td>
                                            <%= mostrar.nome%>
                                        </td>
                                        <td>
                                            <%= mostrar.descricao%>
                                        </td>
                                        <td>
                                            <%= mostrar.preco%>
                                        </td>
                                        <td>
                                            <%= mostrar.estoque%>
                                        </td>
                                        <td>
                                            <%= mostrar.categoria%>
                                        </td>
                                        <td>
                                            <a class="btn btn-success btn-sm rounded-circle"
                                                href="/produtos/editar/<%= mostrar.id %>"
                                                ><i class="bi bi-pencil-fill"></i></a>
                                            <a class="btn btn-danger btn-sm rounded-circle"
                                                href="/produtos/excluir/<%= mostrar.id %>"
                                                onclick="return confirm('Deseja excluir este produto?')"><i class="bi bi-trash-fill"></i></a>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <%- include("../partials/footer") %>
